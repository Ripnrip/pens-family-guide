{
  "name": "pens-chatgpt-app",
  "version": "0.2.0",
  "private": true,
  "description": "PENS (Pediatric Epilepsy & Neurology Specialists, Tampa Bay): MCP Apps server with widgets for ChatGPT and Claude",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "node dist/dev.js",
    "build": "tsc -p tsconfig.json",
    "build:static": "node scripts/prepare-static.mjs",
    "build:vercel": "npm run build && npm run build:static",
    "brand:png": "node scripts/render-logo.mjs",
    "team:photos": "node scripts/team-photos.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:pack": "node scripts/pack-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "jsdom": "^31.0.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
